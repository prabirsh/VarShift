# Auto detect text files and perform LF normalization
* text=auto

# These run on Linux and WSL, so they must keep LF even when checked out on Windows.
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.vcf text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf

*.gz binary
*.xlsx binary
